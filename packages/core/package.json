{
  "name": "@diceui/pptx-core",
  "version": "0.1.2",
  "description": "PPTX engine for parsing, rendering, editing, and saving PowerPoint presentations in the browser.",
  "keywords": [
    "editor",
    "ooxml",
    "powerpoint",
    "pptx",
    "presentation",
    "renderer",
    "slides",
    "viewer"
  ],
  "homepage": "https://pptx.diceui.com",
  "bugs": {
    "url": "https://github.com/sadmann7/pptx/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Sadman Sakib",
    "url": "https://x.com/sadmann17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadmann7/pptx.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSES"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./fonts": "./src/fonts/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./fonts": {
        "types": "./dist/fonts/index.d.mts",
        "import": "./dist/fonts/index.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "bench": "vitest bench --run",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "jszip": "catalog:"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@pptx/config": "workspace:*",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "jsdom": "catalog:",
    "rolldown": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
