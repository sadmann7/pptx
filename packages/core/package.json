{
  "name": "@diceui/pptx-core",
  "version": "0.1.0",
  "description": "Framework-agnostic PPTX engine: parse, render, edit, and save PowerPoint presentations in the browser.",
  "keywords": [
    "editor",
    "ooxml",
    "powerpoint",
    "pptx",
    "presentation",
    "renderer",
    "viewer"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadmann7/pptx.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSES"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./fonts": "./src/fonts/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./fonts": {
        "types": "./dist/fonts/index.d.mts",
        "import": "./dist/fonts/index.mjs"
      }
    }
  },
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsdown",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "^1.2.3",
    "@pptx/config": "workspace:*",
    "@types/jsdom": "^28.0.3",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "jsdom": "^29.1.1",
    "mtx-decompressor": "^1.4.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
