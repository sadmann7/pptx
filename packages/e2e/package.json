{
  "name": "@diceui/pptx-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Browser end-to-end tests for the PPTX renderer (Playwright + Vite harness).",
  "type": "module",
  "scripts": {
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "harness": "vite --port 5000 --strictPort",
    "oracle:export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-powerpoint.ps1",
    "shoot": "tsx scripts/shoot.ts",
    "probe": "tsx scripts/probe.ts",
    "faults": "tsx scripts/faults.ts",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:update": "playwright test --update-snapshots",
    "test:oracle-update": "cross-env ORACLE_UPDATE=1 playwright test oracle",
    "test:perf": "cross-env PERF=1 playwright test thumbnail-perf --project=chromium",
    "report": "playwright show-report"
  },
  "dependencies": {
    "@diceui/pptx": "workspace:*",
    "@diceui/pptx-core": "workspace:*"
  },
  "devDependencies": {
    "@blazediff/ssim": "^1.7.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "cross-env": "^10.1.0",
    "jszip": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "^0.35.3",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "vite": "^7.3.6"
  }
}
