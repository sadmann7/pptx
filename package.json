{
  "name": "pptx",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "oxlint --fix",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check": "turbo lint typecheck && pnpm format",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build --filter=!docs && changeset publish",
    "clean": "rimraf --glob **/node_modules **/.next **/dist .turbo",
    "dev:web": "turbo -F web dev"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@pptx/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.16",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
